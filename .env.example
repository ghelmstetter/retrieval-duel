# Copy this file to .env and fill in your key. Never commit .env (it's in .gitignore).

# Your Anthropic API key, from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Models. The cheap one does the bulk work (graph extraction, summaries, routing, grading);
# the strong one writes the answers you compare.
RDUEL_WORK_MODEL=claude-haiku-5-5
RDUEL_ANSWER_MODEL=claude-sonnet-5-5

# Prices in US dollars per million tokens, used for cost estimates only.
# Check https://www.anthropic.com/pricing and update if they've changed.
RDUEL_WORK_PRICE_IN=0.10
RDUEL_WORK_PRICE_OUT=0.50
RDUEL_ANSWER_PRICE_IN=2.00
RDUEL_ANSWER_PRICE_OUT=10.00

# Safety stop: indexing halts if one run spends more than this many dollars.
RDUEL_MAX_INDEX_DOLLARS=2.00

# Retrieval settings
# How many passages vector search returns
RDUEL_TOP_K=5
# How far GraphRAG walks from the entities in your question
RDUEL_GRAPH_HOPS=2
# The most facts GraphRAG hands to the AI
RDUEL_GRAPH_MAX_FACTS=30

# Embeddings: auto (fastembed if installed, else word matching), fastembed, or tfidf
RDUEL_EMBED_BACKEND=auto

RDUEL_PORT=8000
