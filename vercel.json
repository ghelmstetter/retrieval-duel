{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "web",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "{rduel,demo,web}/**",
      "excludeFiles": "{tests,data,docs}/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/static/:path*", "destination": "/:path*" }
  ]
}
